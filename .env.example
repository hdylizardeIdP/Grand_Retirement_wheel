# Charles Schwab developer app credentials.
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182
SCHWAB_ACCOUNT_HASH=

# Path to the encrypted Schwab OAuth token file.
SCHWAB_TOKEN_PATH=./.secrets/schwab_token.json.enc

# Fernet key used to encrypt the token at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SCHWAB_TOKEN_ENCRYPTION_KEY=

# SQLite database path.
WHEEL_DB_PATH=./wheel.db

# Per-ticker config (target delta, DTE range, etc.).
WHEEL_TICKERS_PATH=./tickers.yaml

# Logging level: DEBUG, INFO, WARNING, ERROR.
WHEEL_LOG_LEVEL=INFO
